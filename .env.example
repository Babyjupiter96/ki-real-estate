# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Database (Postgres) ---
# Local dev: a local Postgres connection string.
# Production: the connection string your host (Render, Neon, Supabase, etc.) gives you.
DATABASE_URL=postgresql://user@localhost:5432/ki_dev

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# This project (Ki Real Estate) also hosts the shared CRM/API that the
# separate Ki SEO site calls into. Point these at the SEO site's URL and
# allow it to call /api/lead and /api/track cross-origin.
NEXT_PUBLIC_SEO_URL=http://localhost:3003
ALLOWED_ORIGINS=http://localhost:3003

# --- CRM admin login ---
# The shared password used to sign in at /admin/login.
ADMIN_PASSWORD=change-me
# Any long random string, used to sign admin session cookies.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-too

# --- Email (Gmail SMTP) ---
# 1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
# 2. Create an App Password: myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces).
GMAIL_USER=vandalbamis@gmail.com
GMAIL_APP_PASSWORD=

# Where lead notifications + follow-up reminders are sent.
# Defaults to GMAIL_USER if not set.
NOTIFY_EMAIL=vandalbamis@gmail.com
